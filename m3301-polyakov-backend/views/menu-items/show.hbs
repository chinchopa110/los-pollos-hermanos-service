<section class="section">
    <div class="container">
        <h2 class="section__title">{{item.name}}</h2>
        <article class="news-card" style="max-width: 40rem;">
            <p class="news-card__date">Категория: {{item.category}} · {{item.priceRub}}&nbsp;₽</p>
            <p class="news-card__text">{{item.description}}</p>
            <p class="news-card__date">Доступно: {{#if item.isAvailable}}да{{else}}нет{{/if}}</p>
            {{#if item.imageUrl}}
            <img src="{{item.imageUrl}}" alt="{{item.name}}"
                 style="max-width:100%; border-radius:8px; margin-top:0.75rem;">
            {{/if}}
            <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-top:1rem;">
                <a href="/menu-items/{{item.id}}/edit" class="button button--primary">Редактировать</a>
                <a href="/menu-items" class="button button--secondary">К списку</a>
                <form method="post" action="/menu-items/{{item.id}}/delete" style="display:inline;" onsubmit="return confirm('Удалить позицию?');">
                    <button type="submit" class="button button--secondary">Удалить</button>
                </form>
            </div>
        </article>
    </div>
</section>
